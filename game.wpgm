import wollok.game.*
import personaje.*
import cultivos.*

program farmville {
	//  CONFIG	
	game.title("La granja")
	game.height(10)
	game.width(10)
	game.ground("ground.png")

	//  VISUALES
 	game.addVisualCharacter(personaje)
 	game.addVisual(new Maiz()) // Se agrega a modo de prueba
 	
 	//  COMIENZA
	game.start()
	//teclas
	keyboard.m().OnPressDo({hector.sembrarSemilla(new Maiz())})
		keyboard.t().OnPressDo({hector.sembrarSemilla(new Trigo())})
		keyboard.o().OnPressDo({hector.sembrarSemilla(new Tomaco())})
		keyboard.r().OnPressDo({hector.regarPlanta(game.uniqueCollider(self))})
}
